# ============================================================
# Omran Toys Automation — Environment Variables
# Copy to .env and fill real values. NEVER commit .env to Git.
# ============================================================

# ---------- Server ----------
PORT=3000
HOST=0.0.0.0
# Public HTTPS base URL of THIS automation server.
# Used to build product image URLs sent to the store.
PUBLIC_BASE_URL=https://automation.omrantoys.store

# ---------- Telegram ----------
# From @BotFather
TELEGRAM_BOT_TOKEN=
# Random secret sent by Telegram on every webhook (set via webhook:setup)
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated Telegram user IDs allowed to use the bot (whitelist)
TELEGRAM_ADMIN_IDS=

# ---------- AI (OpenAI) ----------
# One call per product. Cheap model by default (cost policy).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: compatible API base URL (default: https://api.openai.com/v1)
# OPENAI_BASE_URL=https://api.openai.com/v1

# ---------- Store API (omrantoys-store server-to-server) ----------
# Base URL of the store's Worker API (no trailing slash)
STORE_API_URL=
# Server-to-server credentials (created with `wrangler secret put` in the store project)
STORE_API_KEY=
STORE_API_SECRET=
# Public base URL of the storefront (for product links)
STORE_BASE_URL=https://omrantoys.store

# ---------- Storage ----------
# SQLite database file
DATABASE_PATH=./data/automation.db
# Directory where product images are stored
STORAGE_DIR=./storage

# ---------- Limits ----------
# Max image size from Telegram (MB)
MAX_IMAGE_MB=10
# AI calls per chat per hour (backstop against loops)
AI_CALLS_PER_CHAT_PER_HOUR=5
# Publish attempts per chat per hour (backstop against loops)
PUBLISH_ATTEMPTS_PER_CHAT_PER_HOUR=20
